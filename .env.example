NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_recruitment
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Use separate high-entropy values (at least 32 characters each in production).
SESSION_TOKEN_PEPPER=replace-with-a-long-random-secret
PASSWORD_RESET_SECRET=replace-with-a-different-long-random-secret
SESSION_TTL_HOURS=24
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30
BCRYPT_ROUNDS=12

# Used only by `npm run seed`; never commit a real password.
SUPER_ADMIN_EMAIL=admin@example.edu
SUPER_ADMIN_PASSWORD=replace-with-a-strong-initial-password
SUPER_ADMIN_EMPLOYEE_ID=ADMIN-001

# Frontend API base URL (leave empty for Vite proxy /api)
VITE_API_BASE_URL=
